{
  "name": "openclaw-office",
  "version": "0.5.0",
  "description": "OpenClaw-managed bridge for the AWTRIX OpenClaw Office display",
  "type": "module",
  "license": "MIT",
  "files": [
    "index.mjs",
    "service.mjs",
    "openclaw.plugin.json",
    "payload",
    "README.md",
    "LICENSE",
    "OpenClawOfficeLive.ax",
    "plugin-config.example.json",
    "skills",
    "docs",
    "scripts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test *.test.mjs payload/bridge/*.test.mjs media/*.test.mjs",
    "check": "node scripts/check-integrity.mjs",
    "plugin:check": "plugin-inspector ci --no-openclaw --runtime --mock-sdk --allow-execute"
  },
  "dependencies": {
    "@openclaw/gateway-client": "2026.8.1",
    "@openclaw/gateway-protocol": "2026.10.6"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.2"
  },
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliseo-juan/openclaw-office-awtrix.git"
  },
  "devDependencies": {
    "@openclaw/plugin-inspector": "0.4.4",
    "yaml": "2.8.3"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "bugs": {
    "url": "https://github.com/eliseo-juan/openclaw-office-awtrix/issues"
  },
  "homepage": "https://github.com/eliseo-juan/openclaw-office-awtrix#readme",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "awtrix",
    "awtrix-ng",
    "pixel-art",
    "agent-monitoring"
  ]
}
